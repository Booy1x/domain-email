{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "domain-inbox",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "workers_dev": false,
  "routes": [
    { "pattern": "mail.525458.xyz/*", "zone_name": "525458.xyz" }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "MAX_RAW_BYTES": "26214400",
    "MAX_BODY_PART_BYTES": "524288",
    "MAX_BODY_TOTAL_BYTES": "786432",
    "MAX_ATTACHMENT_COUNT": "25",
    "MAX_ATTACHMENT_BYTES": "10485760",
    "MAX_ATTACHMENTS_TOTAL_BYTES": "20971520",
    "MAX_QUERY_LENGTH": "200",
    "MAX_PAGE_SIZE": "100",
    "OBJECT_CONCURRENCY": "4",
    "CLEANUP_EMAILS_PER_RUN": "1"
  },
  "d1_databases": [
    {
      "binding": "INBOX_DB",
      "database_name": "inbox-db",
      "database_id": "5adf1225-b4a7-4899-957f-0a9244fca5b3"
    }
  ],
  "r2_buckets": [
    {
      "binding": "INBOX_BUCKET",
      "bucket_name": "mail-storage"
    }
  ]
}
